# Copy to .env.local and replace placeholders with private values.
# Never commit .env.local or real credentials.

MONGODB_URI=mongodb://127.0.0.1:27017/seo_product
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_SECRET=replace-with-another-at-least-32-random-characters

# Public canonical origin used by robots and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://example.com

# Cloudinary signed image uploads and remote media deletion.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=seo_product_signed
